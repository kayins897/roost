# Normalize text files to LF in the repository; keep Windows scripts CRLF.
* text=auto eol=lf

*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.icns binary
*.woff2 binary
*.ttf binary
*.exe binary
*.dll binary
*.zip binary
*.7z binary
*.node binary
*.glb binary
